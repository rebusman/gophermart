{
  "gofumpt": true,
  "staticcheck": true,
  "semanticTokens": true,
  "verboseOutput": false,
  "ui.semanticTokens": true,
  "analyses": {
    "unusedparams": true,
    "unusedwrite": true,
    "useany": true,
    "nilness": true,
    "shadow": true,
    "modernize": true,
    "simplifycompositelit": true,
    "simplifyrange": true,
    "simplifyslice": true
  },
  "hints": {
    "assignVariableTypes": true,
    "compositeLiteralFields": true,
    "compositeLiteralTypes": true,
    "constantValues": true,
    "functionTypeParameters": true,
    "parameterNames": false,
    "rangeVariableTypes": true
  },
  "directoryFilters": [
    "-vendor",
    "-.git",
    "-tmp",
    "-dist",
    "-bin"
  ],
  "buildFlags": [
    "-tags=integration"
  ],
  "env": {
    "GOFLAGS": "-mod=mod"
  }
}